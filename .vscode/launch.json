//launch-docker-all
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AppWebApi",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/AppWebApi/bin/Debug/net9.0/AppWebApi.dll",
            "cwd": "${workspaceFolder}/AppWebApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "AppRazor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/AppRazor/bin/Debug/net9.0/AppRazor.dll",
            "cwd": "${workspaceFolder}/AppRazor",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7065;http://localhost:5105"
            }
        }
    ],
    "compounds": [
        {
            "name": "API + Razor",
            "configurations": [
                "AppWebApi",
                "AppRazor"
            ]
        }
    ]
}