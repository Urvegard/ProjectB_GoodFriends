{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ApplicationSecrets": {
      "SecretStorage": "UserSecrets"
  },

  "DatabaseConnections": {
    "DefaultDataUser": "dbo",    // "gstusr" | "usr" | "supusr" | "dbo" | "root"
    "MigrationUser": "root",     // migration is done by root user
    "UseDataSetWithTag": "sql-friends.sqlserver.docker" 
  },

  "DataService": 
  {
    "DataSource": "Database", //"Database" | "WebApi"
    // "WebApiBaseUri": "https://seido.se/api"
    "WebApiBaseUri": "https://localhost:5106/api/"
    // "WebApiBaseUri": "https://friends.api.secure.seido.se/api"
  }
}
