@page
@model AppRazor.Pages.AllFriends
@{
    ViewData["Title"] = "All Friends";
}
<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-danger">@Model.Message</div>
}

@if (Model.Friends.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Birthday</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var friend in Model.Friends)
        {
            <tr>
                <td>@friend.FirstName @friend.LastName</td>
                <td>@friend.Email</td>
                <td>@friend.Birthday?.ToShortDateString()</td>
                
                @* För att koppla mot 'detaljsidan' för att få åtkomst till detaljer över specifik vän *@
                <td>
                    <a asp-page="/FriendsInDetail"
                       asp-route-friendId="@friend.FriendId"
                       class="btn btn-primary btn-sm">
                        View Details
                    </a>
                </td>
                @* För att koppla mot 'editsidan' för att kunna editera specifik vän *@
                <td>
                    <a asp-page="/EditFriend"
                       asp-route-friendId="@friend.FriendId"
                       class="btn btn-primary btn-sm">
                        Edit
                    </a>
                </td>
                @* För att koppla mot 'editsidan' för att kunna editera adress hos specifik vän *@
                <td>
                    <a asp-page="/EditFriendAddress"
                       asp-route-friendId="@friend.FriendId"
                       class="btn btn-primary btn-sm">
                        Edit Adress
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No friends found.</p>
}
