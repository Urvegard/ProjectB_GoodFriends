@page "{friendId:guid}"
@model AppRazor.Pages.EditFriend
@{
    ViewData["Title"] = "Edit Friend";
}

<h1>Edit Friend</h1>

<form method="post">
    <input type="hidden" asp-for="Friend.FriendId" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <p>
        <strong>First Name:</strong><br />
        <input asp-for="Friend.FirstName" class="form-control" />
        <span asp-validation-for="Friend.FirstName" class="text-danger"></span>
    </p>

    <p>
        <strong>Last Name:</strong><br />
        <input asp-for="Friend.LastName" class="form-control" />
        <span asp-validation-for="Friend.LastName" class="text-danger"></span>
    </p>

    <p>
        <strong>Email:</strong><br />
        <input asp-for="Friend.Email" class="form-control" />
        <span asp-validation-for="Friend.Email" class="text-danger"></span>
    </p>

    <p>
        <strong>Birthday:</strong><br />
        <input asp-for="Friend.Birthday" type="date" class="form-control" />
        <span asp-validation-for="Friend.Birthday" class="text-danger"></span>
    </p>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-page="/FriendsInDetail" asp-route-friendId="@Model.Friend?.FriendId" class="btn btn-secondary">
        Cancel
    </a>
</form>

<hr />

<h3>Pets</h3>
@if (Model.FriendFull?.Pets != null && Model.FriendFull.Pets.Any())
{
    <ul>
        @foreach (var pet in Model.FriendFull.Pets)
        {
            <li>
                @pet.Name (@pet.Kind)
                <form method="post" asp-page-handler="DeletePet" class="d-inline">
                    <input type="hidden" name="petId" value="@pet.PetId" />
                    <button type="submit" class="btn btn-sm btn-danger">🗑️Remove/Delete🗑️</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>No pets.</p>
}

<h3>Quotes</h3>
@if (Model.FriendFull?.Quotes != null && Model.FriendFull.Quotes.Any())
{
    <ul>
        @foreach (var quote in Model.FriendFull.Quotes)
        {
            <li>
                "@quote.QuoteText" - @quote.Author
                <form method="post" asp-page-handler="DeleteQuote" class="d-inline">
                    <input type="hidden" name="quoteId" value="@quote.QuoteId" />
                    <button type="submit" class="btn btn-sm btn-danger">🗑️Remove/Delete🗑️</button>
                </form>
            </li>
        }
    </ul>
}
else
{
    <p>No quotes.</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}